<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.system.mapper.file.FileStorageConfigMapper">

    <resultMap type="com.xinling.system.domain.entity.file.FileStorageConfig" id="FileStorageConfigResult">
        <id     property="id"               column="id"                />
        <result property="name"             column="name"              />
        <result property="storageType"      column="storage_type"      />
        <result property="isMaster"         column="is_master"         />
        <result property="endpoint"         column="endpoint"          />
        <result property="bucketName"       column="bucket_name"       />
        <result property="accessKeyId"      column="access_key_id"     />
        <result property="accessKeySecret"  column="access_key_secret" />
        <result property="region"           column="region"            />
        <result property="customDomain"     column="custom_domain"     />
        <result property="basePath"         column="base_path"         />
        <result property="maxFileSize"      column="max_file_size"     />
        <result property="allowedExtensions" column="allowed_extensions" />
        <result property="status"           column="status"            />
        <result property="sortOrder"        column="sort_order"        />
        <result property="remark"           column="remark"            />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
    </resultMap>

    <sql id="selectFileStorageConfigVo">
        select id, name, storage_type, is_master, endpoint, bucket_name, access_key_id,
               access_key_secret, region, custom_domain, base_path, max_file_size,
               allowed_extensions, status, sort_order, remark, create_by, create_time, update_by, update_time
        from sys_file_storage_config
    </sql>

    <select id="selectFileStorageConfigList" parameterType="com.xinling.system.domain.entity.file.FileStorageConfig" resultMap="FileStorageConfigResult">
        <include refid="selectFileStorageConfigVo"/>
        <where>
            <if test="name != null and name != ''">
                AND name like concat('%', #{name}, '%')
            </if>
            <if test="storageType != null and storageType != ''">
                AND storage_type = #{storageType}
            </if>
            <if test="isMaster != null and isMaster != ''">
                AND is_master = #{isMaster}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by sort_order asc, create_time desc
    </select>

    <select id="selectFileStorageConfigById" parameterType="Long" resultMap="FileStorageConfigResult">
        <include refid="selectFileStorageConfigVo"/>
        where id = #{id}
    </select>

    <select id="selectMasterConfig" resultMap="FileStorageConfigResult">
        <include refid="selectFileStorageConfigVo"/>
        where is_master = '1' and status = '0' limit 1
    </select>

    <insert id="insertFileStorageConfig" parameterType="com.xinling.system.domain.entity.file.FileStorageConfig">
        insert into sys_file_storage_config (
            <if test="name != null and name != ''">name,</if>
            <if test="storageType != null and storageType != ''">storage_type,</if>
            <if test="isMaster != null and isMaster != ''">is_master,</if>
            <if test="endpoint != null and endpoint != ''">endpoint,</if>
            <if test="bucketName != null and bucketName != ''">bucket_name,</if>
            <if test="accessKeyId != null and accessKeyId != ''">access_key_id,</if>
            <if test="accessKeySecret != null and accessKeySecret != ''">access_key_secret,</if>
            <if test="region != null and region != ''">region,</if>
            <if test="customDomain != null and customDomain != ''">custom_domain,</if>
            <if test="basePath != null and basePath != ''">base_path,</if>
            <if test="maxFileSize != null">max_file_size,</if>
            <if test="allowedExtensions != null and allowedExtensions != ''">allowed_extensions,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="name != null and name != ''">#{name},</if>
            <if test="storageType != null and storageType != ''">#{storageType},</if>
            <if test="isMaster != null and isMaster != ''">#{isMaster},</if>
            <if test="endpoint != null and endpoint != ''">#{endpoint},</if>
            <if test="bucketName != null and bucketName != ''">#{bucketName},</if>
            <if test="accessKeyId != null and accessKeyId != ''">#{accessKeyId},</if>
            <if test="accessKeySecret != null and accessKeySecret != ''">#{accessKeySecret},</if>
            <if test="region != null and region != ''">#{region},</if>
            <if test="customDomain != null and customDomain != ''">#{customDomain},</if>
            <if test="basePath != null and basePath != ''">#{basePath},</if>
            <if test="maxFileSize != null">#{maxFileSize},</if>
            <if test="allowedExtensions != null and allowedExtensions != ''">#{allowedExtensions},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateFileStorageConfig" parameterType="com.xinling.system.domain.entity.file.FileStorageConfig">
        update sys_file_storage_config
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="storageType != null and storageType != ''">storage_type = #{storageType},</if>
            <if test="isMaster != null and isMaster != ''">is_master = #{isMaster},</if>
            <if test="endpoint != null and endpoint != ''">endpoint = #{endpoint},</if>
            <if test="bucketName != null and bucketName != ''">bucket_name = #{bucketName},</if>
            <if test="accessKeyId != null and accessKeyId != ''">access_key_id = #{accessKeyId},</if>
            <if test="accessKeySecret != null and accessKeySecret != ''">access_key_secret = #{accessKeySecret},</if>
            <if test="region != null and region != ''">region = #{region},</if>
            <if test="customDomain != null and customDomain != ''">custom_domain = #{customDomain},</if>
            <if test="basePath != null and basePath != ''">base_path = #{basePath},</if>
            <if test="maxFileSize != null">max_file_size = #{maxFileSize},</if>
            <if test="allowedExtensions != null and allowedExtensions != ''">allowed_extensions = #{allowedExtensions},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteFileStorageConfigById" parameterType="Long">
        delete from sys_file_storage_config where id = #{id}
    </delete>

    <delete id="deleteFileStorageConfigByIds" parameterType="Long">
        delete from sys_file_storage_config where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="clearMasterConfig">
        update sys_file_storage_config set is_master = '0', update_time = sysdate() where is_master = '1'
    </update>

    <update id="setMasterConfig" parameterType="Long">
        update sys_file_storage_config set is_master = '1', update_time = sysdate() where id = #{id}
    </update>

</mapper>
