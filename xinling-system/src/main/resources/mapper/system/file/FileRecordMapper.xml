<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.system.mapper.file.FileRecordMapper">

    <resultMap type="com.xinling.system.domain.entity.file.FileRecord" id="FileRecordResult">
        <id     property="fileId"          column="file_id"           />
        <result property="fileUuid"        column="file_uuid"         />
        <result property="configId"        column="config_id"         />
        <result property="fileName"        column="file_name"         />
        <result property="storedName"      column="stored_name"       />
        <result property="filePath"        column="file_path"         />
        <result property="fileUrl"         column="file_url"          />
        <result property="fileSize"        column="file_size"         />
        <result property="fileType"        column="file_type"         />
        <result property="fileExtension"   column="file_extension"    />
        <result property="fileHash"        column="file_hash"         />
        <result property="storageType"     column="storage_type"      />
        <result property="bucketName"      column="bucket_name"       />
        <result property="objectKey"       column="object_key"        />
        <result property="thumbnailUrl"    column="thumbnail_url"     />
        <result property="imageWidth"      column="image_width"       />
        <result property="imageHeight"     column="image_height"      />
        <result property="duration"        column="duration"          />
        <result property="businessType"    column="business_type"     />
        <result property="businessId"      column="business_id"       />
        <result property="businessTable"   column="business_table"    />
        <result property="businessField"   column="business_field"    />
        <result property="sourceType"      column="source_type"       />
        <result property="isPublic"        column="is_public"         />
        <result property="accessLevel"     column="access_level"      />
        <result property="uploaderId"      column="uploader_id"       />
        <result property="uploaderName"    column="uploader_name"     />
        <result property="uploaderIp"      column="uploader_ip"       />
        <result property="downloadCount"   column="download_count"    />
        <result property="referenceCount"  column="reference_count"   />
        <result property="status"          column="status"            />
        <result property="deleteBy"        column="delete_by"         />
        <result property="deleteTime"      column="delete_time"       />
        <result property="expireTime"      column="expire_time"       />
        <result property="tenantId"        column="tenant_id"         />
        <result property="remark"          column="remark"            />
        <result property="createTime"      column="create_time"       />
        <result property="updateTime"      column="update_time"       />
    </resultMap>

    <sql id="selectFileRecordVo">
        select file_id, file_uuid, config_id, file_name, stored_name, file_path, file_url,
               file_size, file_type, file_extension, file_hash,
               storage_type, bucket_name, object_key,
               thumbnail_url, image_width, image_height, duration,
               business_type, business_id, business_table, business_field,
               source_type, is_public, access_level,
               uploader_id, uploader_name, uploader_ip,
               download_count, reference_count,
               status, delete_by, delete_time, expire_time, tenant_id,
               remark, create_time, update_time
        from sys_file_record
    </sql>

    <select id="selectFileRecordList" parameterType="com.xinling.system.domain.entity.file.FileRecord" resultMap="FileRecordResult">
        <include refid="selectFileRecordVo"/>
        <where>
            <if test="fileName != null and fileName != ''">
                AND file_name like concat('%', #{fileName}, '%')
            </if>
            <if test="storageType != null and storageType != ''">
                AND storage_type = #{storageType}
            </if>
            <if test="businessType != null and businessType != ''">
                AND business_type = #{businessType}
            </if>
            <if test="businessId != null">
                AND business_id = #{businessId}
            </if>
            <if test="businessTable != null and businessTable != ''">
                AND business_table = #{businessTable}
            </if>
            <if test="businessField != null and businessField != ''">
                AND business_field = #{businessField}
            </if>
            <if test="sourceType != null and sourceType != ''">
                AND source_type = #{sourceType}
            </if>
            <if test="isPublic != null">
                AND is_public = #{isPublic}
            </if>
            <if test="accessLevel != null and accessLevel != ''">
                AND access_level = #{accessLevel}
            </if>
            <if test="fileType != null and fileType != ''">
                AND file_type = #{fileType}
            </if>
            <if test="uploaderName != null and uploaderName != ''">
                AND uploader_name like concat('%', #{uploaderName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="tenantId != null">
                AND tenant_id = #{tenantId}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(create_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(create_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectFileRecordById" parameterType="Long" resultMap="FileRecordResult">
        <include refid="selectFileRecordVo"/>
        where file_id = #{fileId}
    </select>

    <select id="selectFileRecordByUuid" parameterType="String" resultMap="FileRecordResult">
        <include refid="selectFileRecordVo"/>
        where file_uuid = #{fileUuid}
    </select>

    <select id="selectFileRecordByHash" parameterType="String" resultMap="FileRecordResult">
        <include refid="selectFileRecordVo"/>
        where file_hash = #{fileHash} and status = '0'
        order by create_time desc
    </select>

    <select id="selectFileRecordByBusiness" parameterType="com.xinling.system.domain.entity.file.FileRecord" resultMap="FileRecordResult">
        <include refid="selectFileRecordVo"/>
        where business_type = #{businessType} and business_id = #{businessId} and status = '0'
        order by create_time desc
    </select>

    <select id="selectFileStatistics" resultMap="FileRecordResult">
        select storage_type,
               count(*) as file_count,
               sum(file_size) as total_size
        from sys_file_record
        where status = '0'
        group by storage_type
    </select>

    <select id="selectExpiredFiles" resultMap="FileRecordResult">
        <include refid="selectFileRecordVo"/>
        where expire_time is not null and expire_time &lt; now() and status = '0'
    </select>

    <insert id="insertFileRecord" parameterType="com.xinling.system.domain.entity.file.FileRecord" useGeneratedKeys="true" keyProperty="fileId">
        insert into sys_file_record (
            <if test="fileUuid != null and fileUuid != ''">file_uuid,</if>
            <if test="configId != null">config_id,</if>
            <if test="fileName != null and fileName != ''">file_name,</if>
            <if test="storedName != null and storedName != ''">stored_name,</if>
            <if test="filePath != null and filePath != ''">file_path,</if>
            <if test="fileUrl != null and fileUrl != ''">file_url,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="fileType != null and fileType != ''">file_type,</if>
            <if test="fileExtension != null and fileExtension != ''">file_extension,</if>
            <if test="fileHash != null and fileHash != ''">file_hash,</if>
            <if test="storageType != null and storageType != ''">storage_type,</if>
            <if test="bucketName != null and bucketName != ''">bucket_name,</if>
            <if test="objectKey != null and objectKey != ''">object_key,</if>
            <if test="thumbnailUrl != null and thumbnailUrl != ''">thumbnail_url,</if>
            <if test="imageWidth != null">image_width,</if>
            <if test="imageHeight != null">image_height,</if>
            <if test="duration != null">duration,</if>
            <if test="businessType != null and businessType != ''">business_type,</if>
            <if test="businessId != null">business_id,</if>
            <if test="businessTable != null and businessTable != ''">business_table,</if>
            <if test="businessField != null and businessField != ''">business_field,</if>
            <if test="sourceType != null and sourceType != ''">source_type,</if>
            <if test="isPublic != null">is_public,</if>
            <if test="accessLevel != null and accessLevel != ''">access_level,</if>
            <if test="uploaderId != null">uploader_id,</if>
            <if test="uploaderName != null and uploaderName != ''">uploader_name,</if>
            <if test="uploaderIp != null and uploaderIp != ''">uploader_ip,</if>
            <if test="downloadCount != null">download_count,</if>
            <if test="referenceCount != null">reference_count,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        )values(
            <if test="fileUuid != null and fileUuid != ''">#{fileUuid},</if>
            <if test="configId != null">#{configId},</if>
            <if test="fileName != null and fileName != ''">#{fileName},</if>
            <if test="storedName != null and storedName != ''">#{storedName},</if>
            <if test="filePath != null and filePath != ''">#{filePath},</if>
            <if test="fileUrl != null and fileUrl != ''">#{fileUrl},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="fileType != null and fileType != ''">#{fileType},</if>
            <if test="fileExtension != null and fileExtension != ''">#{fileExtension},</if>
            <if test="fileHash != null and fileHash != ''">#{fileHash},</if>
            <if test="storageType != null and storageType != ''">#{storageType},</if>
            <if test="bucketName != null and bucketName != ''">#{bucketName},</if>
            <if test="objectKey != null and objectKey != ''">#{objectKey},</if>
            <if test="thumbnailUrl != null and thumbnailUrl != ''">#{thumbnailUrl},</if>
            <if test="imageWidth != null">#{imageWidth},</if>
            <if test="imageHeight != null">#{imageHeight},</if>
            <if test="duration != null">#{duration},</if>
            <if test="businessType != null and businessType != ''">#{businessType},</if>
            <if test="businessId != null">#{businessId},</if>
            <if test="businessTable != null and businessTable != ''">#{businessTable},</if>
            <if test="businessField != null and businessField != ''">#{businessField},</if>
            <if test="sourceType != null and sourceType != ''">#{sourceType},</if>
            <if test="isPublic != null">#{isPublic},</if>
            <if test="accessLevel != null and accessLevel != ''">#{accessLevel},</if>
            <if test="uploaderId != null">#{uploaderId},</if>
            <if test="uploaderName != null and uploaderName != ''">#{uploaderName},</if>
            <if test="uploaderIp != null and uploaderIp != ''">#{uploaderIp},</if>
            <if test="downloadCount != null">#{downloadCount},</if>
            <if test="referenceCount != null">#{referenceCount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateFileRecord" parameterType="com.xinling.system.domain.entity.file.FileRecord">
        update sys_file_record
        <set>
            <if test="fileName != null and fileName != ''">file_name = #{fileName},</if>
            <if test="storedName != null and storedName != ''">stored_name = #{storedName},</if>
            <if test="fileUrl != null and fileUrl != ''">file_url = #{fileUrl},</if>
            <if test="thumbnailUrl != null and thumbnailUrl != ''">thumbnail_url = #{thumbnailUrl},</if>
            <if test="imageWidth != null">image_width = #{imageWidth},</if>
            <if test="imageHeight != null">image_height = #{imageHeight},</if>
            <if test="duration != null">duration = #{duration},</if>
            <if test="businessType != null and businessType != ''">business_type = #{businessType},</if>
            <if test="businessId != null">business_id = #{businessId},</if>
            <if test="businessTable != null and businessTable != ''">business_table = #{businessTable},</if>
            <if test="businessField != null and businessField != ''">business_field = #{businessField},</if>
            <if test="sourceType != null and sourceType != ''">source_type = #{sourceType},</if>
            <if test="isPublic != null">is_public = #{isPublic},</if>
            <if test="accessLevel != null and accessLevel != ''">access_level = #{accessLevel},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="deleteBy != null">delete_by = #{deleteBy},</if>
            <if test="deleteTime != null">delete_time = #{deleteTime},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="referenceCount != null">reference_count = #{referenceCount},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where file_id = #{fileId}
    </update>

    <!-- 软删除：将状态标记为已删除 -->
    <update id="deleteFileRecordById" parameterType="Long">
        update sys_file_record set status = '1', update_time = sysdate()
        where file_id = #{fileId}
    </update>

    <!-- 批量软删除 -->
    <update id="deleteFileRecordByIds" parameterType="Long">
        update sys_file_record set status = '1', update_time = sysdate()
        where file_id in
        <foreach item="fileId" collection="array" open="(" separator="," close=")">
            #{fileId}
        </foreach>
    </update>

    <update id="incrementDownloadCount" parameterType="Long">
        update sys_file_record set download_count = download_count + 1, update_time = sysdate()
        where file_id = #{fileId}
    </update>

    <update id="incrementReferenceCount" parameterType="Long">
        update sys_file_record set reference_count = reference_count + 1, update_time = sysdate()
        where file_id = #{fileId}
    </update>

    <update id="decrementReferenceCount" parameterType="Long">
        update sys_file_record set reference_count = case when reference_count > 0 then reference_count - 1 else 0 end, update_time = sysdate()
        where file_id = #{fileId}
    </update>

</mapper>
