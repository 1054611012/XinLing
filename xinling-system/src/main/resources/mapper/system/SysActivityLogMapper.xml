<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.system.mapper.SysActivityLogMapper">
    
    <resultMap type="SysActivityLog" id="SysActivityLogResult">
        <result property="activityId"    column="activity_id"    />
        <result property="activityType"    column="activity_type"    />
        <result property="icon"    column="icon"    />
        <result property="title"    column="title"    />
        <result property="description"    column="description"    />
        <result property="businessId"    column="business_id"    />
        <result property="activityTime"    column="activity_time"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectActivityLogVo">
        select activity_id, activity_type, icon, title, description, business_id, activity_time, status, create_time, update_time 
        from sys_activity_log
    </sql>

    <select id="selectActivityLogList" parameterType="SysActivityLog" resultMap="SysActivityLogResult">
        <include refid="selectActivityLogVo"/>
        <where>  
            <if test="activityType != null  and activityType != ''"> and activity_type = #{activityType}</if>
            <if test="title != null  and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="params.beginTime != null and params.beginTime != ''">
                and date_format(activity_time,'%Y%m%d') &gt;= date_format(#{params.beginTime},'%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                and date_format(activity_time,'%Y%m%d') &lt;= date_format(#{params.endTime},'%Y%m%d')
            </if>
        </where>
        order by activity_time desc
    </select>
    
    <select id="selectActivityLogById" parameterType="Long" resultMap="SysActivityLogResult">
        <include refid="selectActivityLogVo"/>
        where activity_id = #{activityId}
    </select>

    <select id="selectRecentActivityLogs" resultMap="SysActivityLogResult">
        <include refid="selectActivityLogVo"/>
        where status = '0'
        order by activity_time desc
        limit #{limit}
    </select>
        
    <insert id="insertActivityLog" parameterType="SysActivityLog" useGeneratedKeys="true" keyProperty="activityId">
        insert into sys_activity_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="activityType != null and activityType != ''">activity_type,</if>
            <if test="icon != null and icon != ''">icon,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="businessId != null">business_id,</if>
            <if test="activityTime != null">activity_time,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="activityType != null and activityType != ''">#{activityType},</if>
            <if test="icon != null and icon != ''">#{icon},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="businessId != null">#{businessId},</if>
            <if test="activityTime != null">#{activityTime},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateActivityLog" parameterType="SysActivityLog">
        update sys_activity_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="activityType != null and activityType != ''">activity_type = #{activityType},</if>
            <if test="icon != null and icon != ''">icon = #{icon},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="description != null and description != ''">description = #{description},</if>
            <if test="businessId != null">business_id = #{businessId},</if>
            <if test="activityTime != null">activity_time = #{activityTime},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where activity_id = #{activityId}
    </update>

    <delete id="deleteActivityLogById" parameterType="Long">
        delete from sys_activity_log where activity_id = #{activityId}
    </delete>

    <delete id="deleteActivityLogByIds" parameterType="String">
        delete from sys_activity_log where activity_id in 
        <foreach item="activityId" collection="array" open="(" separator="," close=")">
            #{activityId}
        </foreach>
    </delete>
</mapper>
