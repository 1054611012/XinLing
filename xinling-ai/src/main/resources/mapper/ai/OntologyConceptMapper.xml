<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.ai.mapper.OntologyConceptMapper">

    <resultMap type="com.xinling.ai.domain.ontology.OntologyConcept" id="OntologyConceptResult">
        <result property="conceptId"    column="concept_id"    />
        <result property="conceptName"    column="concept_name"    />
        <result property="conceptCode"    column="concept_code"    />
        <result property="description"    column="description"    />
        <result property="parentId"    column="parent_id"    />
        <result property="parentName"    column="parent_name"    />
        <result property="category"    column="category"    />
        <result property="status"    column="status"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectOntologyConceptVo">
        select c.concept_id, c.concept_name, c.concept_code, c.description,
               c.parent_id, p.concept_name as parent_name, c.category,
               c.status, c.sort_order,
               c.create_by, c.create_time, c.update_by, c.update_time
        from ai_ontology_concept c
        left join ai_ontology_concept p on c.parent_id = p.concept_id
    </sql>

    <select id="selectOntologyConceptList" parameterType="com.xinling.ai.domain.ontology.OntologyConcept" resultMap="OntologyConceptResult">
        <include refid="selectOntologyConceptVo"/>
        <where>
            <if test="conceptName != null and conceptName != ''">
                AND c.concept_name like concat('%', #{conceptName}, '%')
            </if>
            <if test="conceptCode != null and conceptCode != ''">
                AND c.concept_code = #{conceptCode}
            </if>
            <if test="parentId != null">
                AND c.parent_id = #{parentId}
            </if>
            <if test="category != null and category != ''">
                AND c.category = #{category}
            </if>
            <if test="status != null and status != ''">
                AND c.status = #{status}
            </if>
        </where>
        order by c.sort_order, c.concept_id
    </select>

    <select id="selectOntologyConceptById" parameterType="Long" resultMap="OntologyConceptResult">
        <include refid="selectOntologyConceptVo"/>
        where c.concept_id = #{conceptId}
    </select>

    <select id="selectOntologyConceptByCode" parameterType="String" resultMap="OntologyConceptResult">
        <include refid="selectOntologyConceptVo"/>
        where c.concept_code = #{conceptCode}
    </select>

    <select id="selectOntologyConceptByName" parameterType="String" resultMap="OntologyConceptResult">
        <include refid="selectOntologyConceptVo"/>
        where c.concept_name = #{conceptName}
    </select>

    <select id="selectChildConcepts" parameterType="Long" resultMap="OntologyConceptResult">
        <include refid="selectOntologyConceptVo"/>
        where c.parent_id = #{parentId}
        order by c.sort_order
    </select>

    <select id="selectAllEnabledConcepts" resultMap="OntologyConceptResult">
        <include refid="selectOntologyConceptVo"/>
        where c.status = '0'
        order by c.sort_order
    </select>

    <insert id="insertOntologyConcept" parameterType="com.xinling.ai.domain.ontology.OntologyConcept" useGeneratedKeys="true" keyProperty="conceptId">
        insert into ai_ontology_concept
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="conceptName != null and conceptName != ''">concept_name,</if>
            <if test="conceptCode != null and conceptCode != ''">concept_code,</if>
            <if test="description != null">description,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="conceptName != null and conceptName != ''">#{conceptName},</if>
            <if test="conceptCode != null and conceptCode != ''">#{conceptCode},</if>
            <if test="description != null">#{description},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateOntologyConcept" parameterType="com.xinling.ai.domain.ontology.OntologyConcept">
        update ai_ontology_concept
        <trim prefix="SET" suffixOverrides=",">
            <if test="conceptName != null and conceptName != ''">concept_name = #{conceptName},</if>
            <if test="conceptCode != null and conceptCode != ''">concept_code = #{conceptCode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where concept_id = #{conceptId}
    </update>

    <delete id="deleteOntologyConceptById" parameterType="Long">
        delete from ai_ontology_concept where concept_id = #{conceptId}
    </delete>

    <delete id="deleteOntologyConceptByIds" parameterType="Long">
        delete from ai_ontology_concept where concept_id in
        <foreach item="conceptId" collection="array" open="(" separator="," close=")">
            #{conceptId}
        </foreach>
    </delete>

    <select id="checkConceptCodeUnique" resultMap="OntologyConceptResult">
        <include refid="selectOntologyConceptVo"/>
        where c.concept_code = #{conceptCode}
        <if test="conceptId != null and conceptId != 0">
            and c.concept_id != #{conceptId}
        </if>
        limit 1
    </select>

    <select id="searchConceptsByKeyword" parameterType="String" resultMap="OntologyConceptResult">
        <include refid="selectOntologyConceptVo"/>
        where c.concept_name like concat('%', #{keyword}, '%')
           or c.concept_code like concat('%', #{keyword}, '%')
           or c.description like concat('%', #{keyword}, '%')
        order by c.sort_order, c.concept_id
        limit 20
    </select>

    <select id="checkConceptNameUnique" resultMap="OntologyConceptResult">
        <include refid="selectOntologyConceptVo"/>
        where c.concept_name = #{conceptName}
        <if test="conceptId != null and conceptId != 0">
            and c.concept_id != #{conceptId}
        </if>
        limit 1
    </select>

</mapper>