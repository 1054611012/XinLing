<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.ai.mapper.AiPromptMapper">

    <resultMap type="com.xinling.ai.domain.config.AiPrompt" id="AiPromptResult">
        <result property="promptId"    column="prompt_id"    />
        <result property="promptName"  column="prompt_name"  />
        <result property="content"     column="content"      />
        <result property="modelId"     column="model_id"     />
        <result property="modelName"   column="model_name"   />
        <result property="modelCode"   column="model_code"   />
        <result property="status"      column="status"       />
        <result property="sortOrder"   column="sort_order"   />
        <result property="remark"      column="remark"       />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
    </resultMap>

    <sql id="selectAiPromptVo">
        select p.prompt_id, p.prompt_name, p.content,
               p.model_id, m.model_name, m.model_code,
               p.status, p.sort_order, p.remark,
               p.create_by, p.create_time, p.update_by, p.update_time
        from ai_prompt p
        left join ai_model_config m on p.model_id = m.model_id
    </sql>

    <select id="selectAiPromptList" parameterType="com.xinling.ai.domain.config.AiPrompt" resultMap="AiPromptResult">
        <include refid="selectAiPromptVo"/>
        <where>
            <if test="promptName != null and promptName != ''">
                AND p.prompt_name like concat('%', #{promptName}, '%')
            </if>
            <if test="modelId != null">
                AND p.model_id = #{modelId}
            </if>
            <if test="status != null and status != ''">
                AND p.status = #{status}
            </if>
        </where>
        order by p.sort_order, p.prompt_id
    </select>

    <select id="selectAiPromptById" parameterType="Long" resultMap="AiPromptResult">
        <include refid="selectAiPromptVo"/>
        where p.prompt_id = #{promptId}
    </select>

    <select id="selectPromptsByConfigId" parameterType="Long" resultMap="AiPromptResult">
        <include refid="selectAiPromptVo"/>
        inner join ai_session_prompt sp on p.prompt_id = sp.prompt_id
        where sp.config_id = #{configId}
        order by p.sort_order, p.prompt_id
    </select>

    <select id="selectEnabledPromptsByConfigId" resultMap="AiPromptResult">
        <include refid="selectAiPromptVo"/>
        inner join ai_session_prompt sp on p.prompt_id = sp.prompt_id
        where sp.config_id = #{configId}
          and p.status = '0'
          and (p.model_id is null or p.model_id = #{modelId})
        order by p.sort_order, p.prompt_id
    </select>

    <insert id="insertAiPrompt" parameterType="com.xinling.ai.domain.config.AiPrompt" useGeneratedKeys="true" keyProperty="promptId">
        insert into ai_prompt
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="promptName != null and promptName != ''">prompt_name,</if>
            <if test="content != null and content != ''">content,</if>
            model_id,
            <if test="status != null and status != ''">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="promptName != null and promptName != ''">#{promptName},</if>
            <if test="content != null and content != ''">#{content},</if>
            #{modelId},
            <if test="status != null and status != ''">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiPrompt" parameterType="com.xinling.ai.domain.config.AiPrompt">
        update ai_prompt
        <trim prefix="SET" suffixOverrides=",">
            <if test="promptName != null and promptName != ''">prompt_name = #{promptName},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            model_id = #{modelId},
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where prompt_id = #{promptId}
    </update>

    <delete id="deleteAiPromptById" parameterType="Long">
        delete from ai_prompt where prompt_id = #{promptId}
    </delete>

    <delete id="deleteAiPromptByIds" parameterType="Long">
        delete from ai_prompt where prompt_id in
        <foreach item="promptId" collection="array" open="(" separator="," close=")">
            #{promptId}
        </foreach>
    </delete>

</mapper>
