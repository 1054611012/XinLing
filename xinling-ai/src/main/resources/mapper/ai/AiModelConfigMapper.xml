<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.ai.mapper.AiModelConfigMapper">

    <resultMap type="com.xinling.ai.domain.config.AiModelConfig" id="AiModelConfigResult">
        <result property="modelId"    column="model_id"    />
        <result property="providerId"    column="provider_id"    />
        <result property="providerName"    column="provider_name"    />
        <result property="modelName"    column="model_name"    />
        <result property="modelCode"    column="model_code"    />
        <result property="modelType"    column="model_type"    />
        <result property="apiKey"    column="api_key"    />
        <result property="contextWindow"    column="context_window"    />
        <result property="maxTokens"    column="max_tokens"    />
        <result property="temperature"    column="temperature"    />
        <result property="topP"    column="top_p"    />
        <result property="timeoutSeconds"    column="timeout_seconds"    />
        <result property="isDefault"    column="is_default"    />
        <result property="status"    column="status"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectAiModelConfigVo">
        select mc.model_id, mc.provider_id, p.provider_name, mc.model_name, mc.model_code, 
               mc.model_type, mc.api_key, mc.context_window, mc.max_tokens, mc.temperature, 
               mc.top_p, mc.timeout_seconds, mc.is_default, mc.status, mc.sort_order, mc.remark, 
               mc.create_by, mc.create_time, mc.update_by, mc.update_time
        from ai_model_config mc
        left join ai_model_provider p on mc.provider_id = p.provider_id
    </sql>

    <select id="selectAiModelConfigList" parameterType="com.xinling.ai.domain.config.AiModelConfig" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        <where>
            <if test="providerId != null">
                AND mc.provider_id = #{providerId}
            </if>
            <if test="modelName != null and modelName != ''">
                AND mc.model_name like concat('%', #{modelName}, '%')
            </if>
            <if test="modelCode != null and modelCode != ''">
                AND mc.model_code = #{modelCode}
            </if>
            <if test="modelType != null and modelType != ''">
                AND mc.model_type = #{modelType}
            </if>
            <if test="isDefault != null and isDefault != ''">
                AND mc.is_default = #{isDefault}
            </if>
            <if test="status != null and status != ''">
                AND mc.status = #{status}
            </if>
        </where>
        order by mc.sort_order, mc.model_id
    </select>

    <select id="selectAiModelConfigById" parameterType="Long" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        where mc.model_id = #{modelId}
    </select>

    <select id="selectAiModelConfigByCode" parameterType="String" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        where mc.model_code = #{modelCode}
    </select>

    <select id="selectDefaultChatModel" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        where mc.model_type = 'chat' and mc.is_default = '1' and mc.status = '0'
        limit 1
    </select>

    <select id="selectDefaultEmbeddingModel" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        where mc.model_type = 'embedding' and mc.is_default = '1' and mc.status = '0'
        limit 1
    </select>

    <insert id="insertAiModelConfig" parameterType="com.xinling.ai.domain.config.AiModelConfig" useGeneratedKeys="true" keyProperty="modelId">
        insert into ai_model_config
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="providerId != null">provider_id,</if>
            <if test="modelName != null and modelName != ''">model_name,</if>
            <if test="modelCode != null and modelCode != ''">model_code,</if>
            <if test="modelType != null and modelType != ''">model_type,</if>
            <if test="apiKey != null and apiKey != ''">api_key,</if>
            <if test="contextWindow != null">context_window,</if>
            <if test="maxTokens != null">max_tokens,</if>
            <if test="temperature != null">temperature,</if>
            <if test="topP != null">top_p,</if>
            <if test="timeoutSeconds != null">timeout_seconds,</if>
            <if test="isDefault != null and isDefault != ''">is_default,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="providerId != null">#{providerId},</if>
            <if test="modelName != null and modelName != ''">#{modelName},</if>
            <if test="modelCode != null and modelCode != ''">#{modelCode},</if>
            <if test="modelType != null and modelType != ''">#{modelType},</if>
            <if test="apiKey != null and apiKey != ''">#{apiKey},</if>
            <if test="contextWindow != null">#{contextWindow},</if>
            <if test="maxTokens != null">#{maxTokens},</if>
            <if test="temperature != null">#{temperature},</if>
            <if test="topP != null">#{topP},</if>
            <if test="timeoutSeconds != null">#{timeoutSeconds},</if>
            <if test="isDefault != null and isDefault != ''">#{isDefault},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateAiModelConfig" parameterType="com.xinling.ai.domain.config.AiModelConfig">
        update ai_model_config
        <trim prefix="SET" suffixOverrides=",">
            <if test="providerId != null">provider_id = #{providerId},</if>
            <if test="modelName != null and modelName != ''">model_name = #{modelName},</if>
            <if test="modelCode != null and modelCode != ''">model_code = #{modelCode},</if>
            <if test="modelType != null and modelType != ''">model_type = #{modelType},</if>
            <if test="apiKey != null">api_key = #{apiKey},</if>
            <if test="contextWindow != null">context_window = #{contextWindow},</if>
            <if test="maxTokens != null">max_tokens = #{maxTokens},</if>
            <if test="temperature != null">temperature = #{temperature},</if>
            <if test="topP != null">top_p = #{topP},</if>
            <if test="timeoutSeconds != null">timeout_seconds = #{timeoutSeconds},</if>
            <if test="isDefault != null and isDefault != ''">is_default = #{isDefault},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where model_id = #{modelId}
    </update>

    <delete id="deleteAiModelConfigById" parameterType="Long">
        delete from ai_model_config where model_id = #{modelId}
    </delete>

    <delete id="deleteAiModelConfigByIds" parameterType="Long">
        delete from ai_model_config where model_id in
        <foreach item="modelId" collection="array" open="(" separator="," close=")">
            #{modelId}
        </foreach>
    </delete>

    <select id="checkModelCodeUnique" resultMap="AiModelConfigResult">
        <include refid="selectAiModelConfigVo"/>
        where mc.model_code = #{modelCode}
        <if test="modelId != null and modelId != 0">
            and mc.model_id != #{modelId}
        </if>
        limit 1
    </select>

</mapper>
