<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.ai.mapper.OntologyInstanceMapper">

    <resultMap type="com.xinling.ai.domain.ontology.OntologyInstance" id="OntologyInstanceResult">
        <result property="instanceId"    column="instance_id"    />
        <result property="instanceName"    column="instance_name"    />
        <result property="instanceCode"    column="instance_code"    />
        <result property="conceptId"    column="concept_id"    />
        <result property="conceptName"    column="concept_name"    />
        <result property="description"    column="description"    />
        <result property="status"    column="status"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectOntologyInstanceVo">
        select i.instance_id, i.instance_name, i.instance_code,
               i.concept_id, c.concept_name as concept_name, i.description,
               i.status, i.sort_order,
               i.create_by, i.create_time, i.update_by, i.update_time
        from ai_ontology_instance i
        left join ai_ontology_concept c on i.concept_id = c.concept_id
    </sql>

    <select id="selectOntologyInstanceList" parameterType="com.xinling.ai.domain.ontology.OntologyInstance" resultMap="OntologyInstanceResult">
        <include refid="selectOntologyInstanceVo"/>
        <where>
            <if test="instanceName != null and instanceName != ''">
                AND i.instance_name like concat('%', #{instanceName}, '%')
            </if>
            <if test="instanceCode != null and instanceCode != ''">
                AND i.instance_code = #{instanceCode}
            </if>
            <if test="conceptId != null">
                AND i.concept_id = #{conceptId}
            </if>
            <if test="status != null and status != ''">
                AND i.status = #{status}
            </if>
        </where>
        order by i.sort_order, i.instance_id
    </select>

    <select id="selectOntologyInstanceById" parameterType="Long" resultMap="OntologyInstanceResult">
        <include refid="selectOntologyInstanceVo"/>
        where i.instance_id = #{instanceId}
    </select>

    <select id="selectInstancesByConceptId" parameterType="Long" resultMap="OntologyInstanceResult">
        <include refid="selectOntologyInstanceVo"/>
        where i.concept_id = #{conceptId}
        order by i.sort_order
    </select>

    <insert id="insertOntologyInstance" parameterType="com.xinling.ai.domain.ontology.OntologyInstance" useGeneratedKeys="true" keyProperty="instanceId">
        insert into ai_ontology_instance
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="instanceName != null and instanceName != ''">instance_name,</if>
            <if test="instanceCode != null and instanceCode != ''">instance_code,</if>
            <if test="conceptId != null">concept_id,</if>
            <if test="description != null">description,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="instanceName != null and instanceName != ''">#{instanceName},</if>
            <if test="instanceCode != null and instanceCode != ''">#{instanceCode},</if>
            <if test="conceptId != null">#{conceptId},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateOntologyInstance" parameterType="com.xinling.ai.domain.ontology.OntologyInstance">
        update ai_ontology_instance
        <trim prefix="SET" suffixOverrides=",">
            <if test="instanceName != null and instanceName != ''">instance_name = #{instanceName},</if>
            <if test="instanceCode != null and instanceCode != ''">instance_code = #{instanceCode},</if>
            <if test="conceptId != null">concept_id = #{conceptId},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where instance_id = #{instanceId}
    </update>

    <delete id="deleteOntologyInstanceById" parameterType="Long">
        delete from ai_ontology_instance where instance_id = #{instanceId}
    </delete>

    <delete id="deleteOntologyInstanceByIds" parameterType="Long">
        delete from ai_ontology_instance where instance_id in
        <foreach item="instanceId" collection="array" open="(" separator="," close=")">
            #{instanceId}
        </foreach>
    </delete>

    <select id="selectOntologyInstanceByCode" parameterType="String" resultMap="OntologyInstanceResult">
        <include refid="selectOntologyInstanceVo"/>
        where i.instance_code = #{instanceCode}
        limit 1
    </select>

    <select id="checkInstanceCodeUnique" resultMap="OntologyInstanceResult">
        <include refid="selectOntologyInstanceVo"/>
        where i.instance_code = #{instanceCode}
        <if test="instanceId != null and instanceId != 0">
            and i.instance_id != #{instanceId}
        </if>
        limit 1
    </select>

</mapper>
