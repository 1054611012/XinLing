<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.psyc.mapper.PsycQuestionsMapper">

    <resultMap type="PsycQuestions" id="PsycQuestionsResult">
        <result property="id"    column="id"    />
        <result property="content"    column="content"    />
        <result property="type"    column="type"    />
        <result property="testId"    column="test_id"    />
        <result property="difficulty"    column="difficulty"    />
        <result property="analysis"    column="analysis"    />
        <result property="source"    column="source"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
        <result property="deletedAt"    column="deleted_at"    />
    </resultMap>

    <resultMap id="PsycQuestionsPsycOptionsResult" type="PsycQuestions" extends="PsycQuestionsResult">
        <collection property="psycOptionsList" ofType="PsycOptions" column="id" select="selectPsycOptionsList" />
    </resultMap>

    <resultMap type="PsycOptions" id="PsycOptionsResult">
        <result property="id"    column="id"    />
        <result property="questionId"    column="question_id"    />
        <result property="content"    column="content"    />
        <result property="score"    column="score"    />
        <result property="sortOrder"    column="sort_order"    />
        <result property="createdAt"    column="created_at"    />
        <result property="updatedAt"    column="updated_at"    />
    </resultMap>

    <sql id="selectPsycQuestionsVo">
        select id, content, type, test_id, difficulty, analysis, source, created_by, created_at, updated_at, deleted_at from psyc_questions
    </sql>

    <select id="selectPsycQuestionsList" parameterType="PsycQuestions" resultMap="PsycQuestionsResult">
        <include refid="selectPsycQuestionsVo"/>
        <where>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="testId != null "> and test_id = #{testId}</if>
            <if test="difficulty != null  and difficulty != ''"> and difficulty = #{difficulty}</if>
            <if test="analysis != null  and analysis != ''"> and analysis = #{analysis}</if>
            <if test="source != null  and source != ''"> and source = #{source}</if>
            <if test="createdBy != null "> and created_by = #{createdBy}</if>
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
            <if test="updatedAt != null "> and updated_at = #{updatedAt}</if>
            <if test="deletedAt != null "> and deleted_at = #{deletedAt}</if>
        </where>
    </select>

    <select id="selectPsycQuestionsById" parameterType="Long" resultMap="PsycQuestionsPsycOptionsResult">
        select id, content, type, test_id, difficulty, analysis, source, created_by, created_at, updated_at, deleted_at
        from psyc_questions
        where id = #{id}
    </select>

    <select id="selectPsycOptionsList" resultMap="PsycOptionsResult">
        select id, question_id, content, score, sort_order, created_at, updated_at
        from psyc_options
        where question_id = #{question_id}
    </select>

    <insert id="insertPsycQuestions" parameterType="PsycQuestions" useGeneratedKeys="true" keyProperty="id">
        insert into psyc_questions
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="content != null and content != ''">content,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="testId != null">test_id,</if>
            <if test="difficulty != null and difficulty != ''">difficulty,</if>
            <if test="analysis != null">analysis,</if>
            <if test="source != null">source,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="createdAt != null">created_at,</if>
            <if test="updatedAt != null">updated_at,</if>
            <if test="deletedAt != null">deleted_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="content != null and content != ''">#{content},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="testId != null">#{testId},</if>
            <if test="difficulty != null and difficulty != ''">#{difficulty},</if>
            <if test="analysis != null">#{analysis},</if>
            <if test="source != null">#{source},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="createdAt != null">#{createdAt},</if>
            <if test="updatedAt != null">#{updatedAt},</if>
            <if test="deletedAt != null">#{deletedAt},</if>
         </trim>
    </insert>

    <update id="updatePsycQuestions" parameterType="PsycQuestions">
        update psyc_questions
        <trim prefix="SET" suffixOverrides=",">
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="type != null and type != ''">type = #{type},</if>
            <if test="testId != null">test_id = #{testId},</if>
            <if test="difficulty != null and difficulty != ''">difficulty = #{difficulty},</if>
            <if test="analysis != null">analysis = #{analysis},</if>
            <if test="source != null">source = #{source},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
            <if test="updatedAt != null">updated_at = #{updatedAt},</if>
            <if test="deletedAt != null">deleted_at = #{deletedAt},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePsycQuestionsById" parameterType="Long">
        delete from psyc_questions where id = #{id}
    </delete>

    <delete id="deletePsycQuestionsByIds" parameterType="String">
        delete from psyc_questions where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deletePsycOptionsByQuestionIds" parameterType="String">
        delete from psyc_options where question_id in
        <foreach item="questionId" collection="array" open="(" separator="," close=")">
            #{questionId}
        </foreach>
    </delete>

    <delete id="deletePsycOptionsByQuestionId" parameterType="Long">
        delete from psyc_options where question_id = #{questionId}
    </delete>

    <insert id="batchPsycOptions">
        insert into psyc_options( id, question_id, content, score, sort_order, created_at, updated_at) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.questionId}, #{item.content}, #{item.score}, #{item.sortOrder}, #{item.createdAt}, #{item.updatedAt})
        </foreach>
    </insert>

</mapper>
