<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.psyc.mapper.PsycFeedbackMapper">

    <resultMap type="PsycFeedback" id="PsycFeedbackResult">
        <result property="id"    column="id"    />
        <result property="userId"    column="user_id"    />
        <result property="type"    column="type"    />
        <result property="content"    column="content"    />
        <result property="images"    column="images"    />
        <result property="contact"    column="contact"    />
        <result property="deviceInfo"    column="device_info"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <resultMap id="PsycFeedbackPsycFeedbackReplyResult" type="PsycFeedback" extends="PsycFeedbackResult">
        <collection property="psycFeedbackReplyList" ofType="PsycFeedbackReply" column="id" select="selectPsycFeedbackReplyList" />
    </resultMap>

    <resultMap type="PsycFeedbackReply" id="PsycFeedbackReplyResult">
        <result property="id"    column="id"    />
        <result property="feedbackId"    column="feedback_id"    />
        <result property="replyUserId"    column="reply_user_id"    />
        <result property="content"    column="content"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectPsycFeedbackVo">
        select id, user_id, type, content, images, contact, device_info, status, create_time, update_time from psyc_feedback
    </sql>

    <select id="selectPsycFeedbackList" parameterType="PsycFeedback" resultMap="PsycFeedbackResult">
        <include refid="selectPsycFeedbackVo"/>
        <where>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="images != null  and images != ''"> and images = #{images}</if>
            <if test="contact != null  and contact != ''"> and contact = #{contact}</if>
            <if test="deviceInfo != null  and deviceInfo != ''"> and device_info = #{deviceInfo}</if>
            <if test="status != null "> and status = #{status}</if>
        </where>
    </select>

    <select id="selectPsycFeedbackById" parameterType="Long" resultMap="PsycFeedbackPsycFeedbackReplyResult">
        select id, user_id, type, content, images, contact, device_info, status, create_time, update_time
        from psyc_feedback
        where id = #{id}
    </select>

    <select id="selectPsycFeedbackReplyList" resultMap="PsycFeedbackReplyResult">
        select id, feedback_id, reply_user_id, content, create_time
        from psyc_feedback_reply
        where feedback_id = #{feedback_id}
    </select>

    <insert id="insertPsycFeedback" parameterType="PsycFeedback" useGeneratedKeys="true" keyProperty="id">
        insert into psyc_feedback
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="type != null">type,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="images != null">images,</if>
            <if test="contact != null">contact,</if>
            <if test="deviceInfo != null">device_info,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="type != null">#{type},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="images != null">#{images},</if>
            <if test="contact != null">#{contact},</if>
            <if test="deviceInfo != null">#{deviceInfo},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updatePsycFeedback" parameterType="PsycFeedback">
        update psyc_feedback
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="type != null">type = #{type},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="images != null">images = #{images},</if>
            <if test="contact != null">contact = #{contact},</if>
            <if test="deviceInfo != null">device_info = #{deviceInfo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deletePsycFeedbackById" parameterType="Long">
        delete from psyc_feedback where id = #{id}
    </delete>

    <delete id="deletePsycFeedbackByIds" parameterType="String">
        delete from psyc_feedback where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deletePsycFeedbackReplyByFeedbackIds" parameterType="String">
        delete from psyc_feedback_reply where feedback_id in
        <foreach item="feedbackId" collection="array" open="(" separator="," close=")">
            #{feedbackId}
        </foreach>
    </delete>

    <delete id="deletePsycFeedbackReplyByFeedbackId" parameterType="Long">
        delete from psyc_feedback_reply where feedback_id = #{feedbackId}
    </delete>

    <insert id="batchPsycFeedbackReply">
        insert into psyc_feedback_reply( id, feedback_id, reply_user_id, content, create_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.feedbackId}, #{item.replyUserId}, #{item.content}, #{item.createTime})
        </foreach>
    </insert>
</mapper>
