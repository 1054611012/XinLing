<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.VipGiftRecordMapper">

    <resultMap id="BaseResultMap" type="com.xinling.app.domain.entity.VipGiftRecord">
        <id column="id" property="id" />
        <result column="rule_id" property="ruleId" />
        <result column="user_id" property="userId" />
        <result column="user_nickname" property="userNickname" />
        <result column="grant_type" property="grantType" />
        <result column="vip_days" property="vipDays" />
        <result column="reason" property="reason" />
        <result column="operator_id" property="operatorId" />
        <result column="operator_name" property="operatorName" />
        <result column="expire_time" property="expireTime" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="selectColumns">
        id, rule_id, user_id, user_nickname, grant_type, vip_days,
        reason, operator_id, operator_name, expire_time, status, create_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="selectColumns" />
        FROM vip_gift_record
        WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="selectColumns" />
        FROM vip_gift_record
        <where>
            <if test="ruleId != null">
                AND rule_id = #{ruleId}
            </if>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="grantType != null and grantType != ''">
                AND grant_type = #{grantType}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO vip_gift_record (rule_id, user_id, user_nickname, grant_type, vip_days,
                                      reason, operator_id, operator_name, expire_time)
        VALUES (#{ruleId}, #{userId}, #{userNickname}, #{grantType}, #{vipDays},
                #{reason}, #{operatorId}, #{operatorName}, #{expireTime})
    </insert>

    <select id="countByUserAndRule" resultType="int">
        SELECT COUNT(*)
        FROM vip_gift_record
        WHERE user_id = #{userId} AND rule_id = #{ruleId}
    </select>

</mapper>
