<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.UserExchangeMapper">

    <resultMap id="BaseResultMap" type="com.xinling.app.domain.entity.UserExchange">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="goods_id" property="goodsId" />
        <result column="points" property="points" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="selectColumns">
        id, user_id, goods_id, points, create_time
    </sql>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="selectColumns" />
        FROM user_exchange
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_exchange (user_id, goods_id, points, create_time)
        VALUES (#{userId}, #{goodsId}, #{points}, NOW())
    </insert>

</mapper>
