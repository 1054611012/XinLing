<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.NotificationMapper">

    <resultMap id="BaseResultMap" type="com.xinling.app.domain.entity.Notification">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="type" property="type" />
        <result column="title" property="title" />
        <result column="content" property="content" />
        <result column="target_type" property="targetType" />
        <result column="target_id" property="targetId" />
        <result column="is_read" property="isRead" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="selectColumns">
        id, user_id, type, title, content, target_type, target_id, is_read, create_time
    </sql>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="selectColumns" />
        FROM notification
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="selectColumns" />
        FROM notification
        WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notification (user_id, type, title, content, target_type, target_id, create_time)
        VALUES (#{userId}, #{type}, #{title}, #{content}, #{targetType}, #{targetId}, NOW())
    </insert>

    <update id="markRead">
        UPDATE notification SET is_read = 1 WHERE id = #{id}
    </update>

    <update id="markAllReadByUserId">
        UPDATE notification SET is_read = 1 WHERE user_id = #{userId} AND is_read = 0
    </update>

    <delete id="deleteById">
        DELETE FROM notification WHERE id = #{id}
    </delete>

    <select id="countUnread" resultType="int">
        SELECT COUNT(*) FROM notification WHERE user_id = #{userId} AND is_read = 0
    </select>

</mapper>
