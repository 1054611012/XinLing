<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.MeditationMapper">

    <!-- 基础查询（不含嵌套集合，由 Service 层组装） -->
    <resultMap id="MeditationResult" type="com.xinling.app.domain.entity.Meditation">
        <id column="id" property="id" />
        <result column="title" property="title" />
        <result column="description" property="description" />
        <result column="cover_url" property="coverUrl" />
        <result column="status" property="status" />
        <result column="sort_order" property="sortOrder" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="selectVo">
        SELECT id, title, description, cover_url, status, sort_order, create_time, update_time
        FROM meditation
    </sql>

    <select id="selectById" resultMap="MeditationResult">
        <include refid="selectVo" /> WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="MeditationResult">
        <include refid="selectVo" />
        <where>
            <if test="keyword != null and keyword != ''">
                AND (title LIKE CONCAT('%', #{keyword}, '%') OR description LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY sort_order ASC, id DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO meditation (title, description, cover_url, status, sort_order)
        VALUES (#{title}, #{description}, #{coverUrl}, #{status}, #{sortOrder})
    </insert>

    <update id="updateById">
        UPDATE meditation
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="description != null">description = #{description},</if>
            <if test="coverUrl != null">cover_url = #{coverUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM meditation WHERE id = #{id}
    </delete>

</mapper>
