<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.OrderRefundMapper">

    <resultMap id="OrderRefundResult" type="com.xinling.app.domain.entity.OrderRefund">
        <id column="id" property="id" />
        <result column="order_no" property="orderNo" />
        <result column="user_id" property="userId" />
        <result column="refund_amount" property="refundAmount" />
        <result column="refund_reason" property="refundReason" />
        <result column="refund_status" property="refundStatus" />
        <result column="audit_user_id" property="auditUserId" />
        <result column="audit_time" property="auditTime" />
        <result column="audit_remark" property="auditRemark" />
        <result column="transaction_id" property="transactionId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="selectColumns">
        id, order_no, user_id, refund_amount, refund_reason,
        refund_status, audit_user_id, audit_time, audit_remark,
        transaction_id, create_time, update_time
    </sql>

    <select id="selectById" resultMap="OrderRefundResult">
        SELECT <include refid="selectColumns" />
        FROM order_refund
        WHERE id = #{id}
    </select>

    <select id="selectByOrderNo" resultMap="OrderRefundResult">
        SELECT <include refid="selectColumns" />
        FROM order_refund
        WHERE order_no = #{orderNo}
        ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_refund (
            order_no, user_id, refund_amount, refund_reason,
            refund_status, create_time
        ) VALUES (
            #{orderNo}, #{userId}, #{refundAmount}, #{refundReason},
            #{refundStatus}, NOW()
        )
    </insert>

    <update id="updateById">
        UPDATE order_refund
        <set>
            <if test="refundStatus != null">refund_status = #{refundStatus},</if>
            <if test="auditUserId != null">audit_user_id = #{auditUserId},</if>
            <if test="auditTime != null">audit_time = #{auditTime},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="transactionId != null">transaction_id = #{transactionId},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE order_refund
        SET refund_status = #{refundStatus}
        WHERE id = #{id}
    </update>

</mapper>
