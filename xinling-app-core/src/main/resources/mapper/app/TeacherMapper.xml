<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.TeacherMapper">

    <resultMap id="TeacherResult" type="com.xinling.app.domain.entity.Teacher">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="avatar" property="avatar" />
        <result column="sort_order" property="sortOrder" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="selectVo">
        SELECT id, name, avatar, sort_order, create_time, update_time
        FROM teacher
    </sql>

    <select id="selectById" resultMap="TeacherResult">
        <include refid="selectVo" /> WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="TeacherResult">
        <include refid="selectVo" />
        <where>
            <if test="keyword != null and keyword != ''">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY sort_order ASC, id DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO teacher (name, avatar, sort_order)
        VALUES (#{name}, #{avatar}, #{sortOrder})
    </insert>

    <update id="updateById">
        UPDATE teacher
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM teacher WHERE id = #{id}
    </delete>

</mapper>
