<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.UserDeviceMapper">

    <resultMap id="UserDeviceResult" type="com.xinling.app.domain.entity.UserDevice">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="device_id" property="deviceId" />
        <result column="device_name" property="deviceName" />
        <result column="device_type" property="deviceType" />
        <result column="login_time" property="loginTime" />
        <result column="last_active_time" property="lastActiveTime" />
        <result column="ip_address" property="ipAddress" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="selectColumns">
        id, user_id, device_id, device_name, device_type,
        login_time, last_active_time, ip_address, create_time
    </sql>

    <select id="selectByUserId" resultMap="UserDeviceResult">
        SELECT <include refid="selectColumns" />
        FROM user_device
        WHERE user_id = #{userId}
        ORDER BY last_active_time DESC
    </select>

    <select id="selectByDeviceId" resultMap="UserDeviceResult">
        SELECT <include refid="selectColumns" />
        FROM user_device
        WHERE device_id = #{deviceId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_device (
            user_id, device_id, device_name, device_type,
            login_time, last_active_time, ip_address
        ) VALUES (
            #{userId}, #{deviceId}, #{deviceName}, #{deviceType},
            #{loginTime}, #{lastActiveTime}, #{ipAddress}
        )
    </insert>

    <update id="updateById">
        UPDATE user_device
        <set>
            <if test="deviceName != null">device_name = #{deviceName},</if>
            <if test="lastActiveTime != null">last_active_time = #{lastActiveTime},</if>
            <if test="ipAddress != null">ip_address = #{ipAddress},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM user_device WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM user_device WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByDeviceId">
        DELETE FROM user_device WHERE device_id = #{deviceId}
    </delete>

</mapper>
