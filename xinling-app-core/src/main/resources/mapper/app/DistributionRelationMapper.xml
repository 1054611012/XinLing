<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.DistributionRelationMapper">

    <resultMap id="DistributionRelationResult" type="com.xinling.app.domain.entity.DistributionRelation">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="parent_id" property="parentId" />
        <result column="grandparent_id" property="grandparentId" />
        <result column="bind_time" property="bindTime" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="selectColumns">
        id, user_id, parent_id, grandparent_id, bind_time, create_time
    </sql>

    <select id="selectById" resultMap="DistributionRelationResult">
        SELECT <include refid="selectColumns" />
        FROM distribution_relation
        WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultMap="DistributionRelationResult">
        SELECT <include refid="selectColumns" />
        FROM distribution_relation
        WHERE user_id = #{userId}
    </select>

    <select id="selectByParentId" resultMap="DistributionRelationResult">
        SELECT <include refid="selectColumns" />
        FROM distribution_relation
        WHERE parent_id = #{parentId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByGrandparentId" resultMap="DistributionRelationResult">
        SELECT <include refid="selectColumns" />
        FROM distribution_relation
        WHERE grandparent_id = #{grandparentId}
        ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO distribution_relation (user_id, parent_id, grandparent_id, bind_time)
        VALUES (#{userId}, #{parentId}, #{grandparentId}, NOW())
    </insert>

    <select id="countByParentId" resultType="int">
        SELECT COUNT(*) FROM distribution_relation
        WHERE parent_id = #{parentId}
    </select>

    <select id="countByGrandparentId" resultType="int">
        SELECT COUNT(*) FROM distribution_relation
        WHERE grandparent_id = #{grandparentId}
    </select>
</mapper>
