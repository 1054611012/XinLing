<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.PayConfigMapper">

    <resultMap id="PayConfigResult" type="com.xinling.app.domain.entity.PayConfig">
        <id column="id" property="id" />
        <result column="pay_type" property="payType" />
        <result column="app_id" property="appId" />
        <result column="merchant_id" property="merchantId" />
        <result column="private_key" property="privateKey" />
        <result column="public_key" property="publicKey" />
        <result column="notify_url" property="notifyUrl" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <sql id="selectColumns">
        id, pay_type, app_id, merchant_id, private_key, public_key,
        notify_url, status, create_time, update_time
    </sql>

    <select id="selectById" resultMap="PayConfigResult">
        SELECT <include refid="selectColumns" />
        FROM pay_config
        WHERE id = #{id}
    </select>

    <select id="selectByPayType" resultMap="PayConfigResult">
        SELECT <include refid="selectColumns" />
        FROM pay_config
        WHERE pay_type = #{payType}
        ORDER BY id ASC
    </select>

    <select id="selectEnabledList" resultMap="PayConfigResult">
        SELECT <include refid="selectColumns" />
        FROM pay_config
        WHERE status = 1
        ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pay_config (
            pay_type, app_id, merchant_id, private_key, public_key,
            notify_url, status
        ) VALUES (
            #{payType}, #{appId}, #{merchantId}, #{privateKey}, #{publicKey},
            #{notifyUrl}, #{status}
        )
    </insert>

    <update id="updateById">
        UPDATE pay_config
        <set>
            <if test="appId != null">app_id = #{appId},</if>
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="privateKey != null">private_key = #{privateKey},</if>
            <if test="publicKey != null">public_key = #{publicKey},</if>
            <if test="notifyUrl != null">notify_url = #{notifyUrl},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectList" resultMap="PayConfigResult">
        SELECT <include refid="selectColumns" />
        FROM pay_config
        ORDER BY id ASC
    </select>

</mapper>
