<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinling.app.mapper.MeditationAuthorMapper">

    <resultMap id="MeditationAuthorResult" type="com.xinling.app.domain.entity.MeditationAuthor">
        <id column="id" property="id" />
        <result column="meditation_id" property="meditationId" />
        <result column="audio_item_id" property="audioItemId" />
        <result column="name" property="name" />
        <result column="avatar" property="avatar" />
        <result column="sort_order" property="sortOrder" />
        <result column="create_time" property="createTime" />
        <association property="audioItem" column="audio_item_id"
                     select="com.xinling.app.mapper.AudioItemMapper.selectById" />
    </resultMap>

    <select id="selectByMeditationId" resultMap="MeditationAuthorResult">
        SELECT id, meditation_id, audio_item_id, name, avatar, sort_order, create_time
        FROM meditation_author
        WHERE meditation_id = #{meditationId}
        ORDER BY sort_order ASC, id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO meditation_author (meditation_id, audio_item_id, name, avatar, sort_order)
        VALUES (#{meditationId}, #{audioItemId}, #{name}, #{avatar}, #{sortOrder})
    </insert>

    <insert id="batchInsert">
        INSERT INTO meditation_author (meditation_id, audio_item_id, name, avatar, sort_order) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.meditationId}, #{item.audioItemId}, #{item.name}, #{item.avatar}, #{item.sortOrder})
        </foreach>
    </insert>

    <delete id="deleteByMeditationId">
        DELETE FROM meditation_author WHERE meditation_id = #{meditationId}
    </delete>

</mapper>
